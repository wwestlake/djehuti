@page "/"
@using Djehuti.Architect.Components

<PageTitle>Djehuti Architect</PageTitle>
<HeadContent>
    <meta property="og:title" content="Djehuti Architect" />
    <meta property="og:description" content="Read a repository, build an architecture model, and generate diagrams and docs from it." />
    <meta property="og:url" content="https://lagdaemon.com/architect/" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://lagdaemon.com/logo.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Djehuti Architect" />
    <meta name="twitter:description" content="Read a repository, build an architecture model, and generate diagrams and docs from it." />
    <meta name="twitter:image" content="https://lagdaemon.com/logo.png" />
</HeadContent>

<div class="arch-page arch-page-wide">
    <div class="arch-editor-header">
        <h1>Djehuti Architect</h1>
        <ShareButton Title="Djehuti Architect" Text="Read a repository, build an architecture model, and generate diagrams and docs from it." />
    </div>
    <p class="arch-subtitle">
        Read a repository, build an architecture model, generate diagrams and docs from it.
    </p>
    <p class="arch-status">
        Repo reading and the AI assistant land next -- this is a hand-authored sample model,
        exercising the model &rarr; Mermaid &rarr; SVG pipeline end to end.
    </p>

    <a class="arch-btn arch-btn-primary" href="projects">Go to Projects</a>

    <MermaidDiagram DiagramSource="@_diagramSource" />
</div>

@code {
    private string _diagramSource = "";

    protected override void OnInitialized()
    {
        var model = SampleModels.DjehutiOverview();
        _diagramSource = MermaidGenerator.GenerateContainerDiagram(model);
    }
}
