@namespace Djehuti.Architect.Components
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="arch-share">
    <button type="button" class="arch-btn arch-btn-ghost arch-share-btn" @onclick="OnShareClick" title="Share this page">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" />
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" /><line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
        </svg>
        <span>Share</span>
    </button>

    @if (_copied)
    {
        <span class="arch-share-copied">Copied!</span>
    }

    @if (_menuOpen)
    {
        <div class="arch-auth-menu-backdrop" @onclick="() => _menuOpen = false"></div>
        <div class="arch-auth-menu arch-share-menu">
            <button type="button" class="arch-auth-menu-item" @onclick="CopyLink">Copy link</button>
            <a class="arch-auth-menu-item" href="@EmailHref">Email</a>
            <a class="arch-auth-menu-item" href="@SmsHref">SMS</a>
            <a class="arch-auth-menu-item" href="@FacebookHref" target="_blank" rel="noopener noreferrer">Facebook</a>
            <a class="arch-auth-menu-item" href="@TwitterHref" target="_blank" rel="noopener noreferrer">X (Twitter)</a>
            <a class="arch-auth-menu-item" href="@LinkedInHref" target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <a class="arch-auth-menu-item" href="@WhatsAppHref" target="_blank" rel="noopener noreferrer">WhatsApp</a>
            <a class="arch-auth-menu-item" href="@TelegramHref" target="_blank" rel="noopener noreferrer">Telegram</a>
        </div>
    }
</div>

@code {
    /// <summary>Page title passed to the native share sheet and used in fallback links.</summary>
    [Parameter] public string Title { get; set; } = "Djehuti Architect";

    /// <summary>Short description/text passed alongside the title where the destination supports it.</summary>
    [Parameter] public string? Text { get; set; }

    /// <summary>Exact URL to share. Defaults to the current page's URL.</summary>
    [Parameter] public string? Url { get; set; }

    private IJSObjectReference? _module;
    private bool _menuOpen;
    private bool _copied;

    private string ShareUrl => Url ?? Nav.Uri;
    private string ShareText => Text ?? Title;

    private string EmailHref => $"mailto:?subject={Uri.EscapeDataString(Title)}&body={Uri.EscapeDataString(ShareText + " " + ShareUrl)}";
    private string SmsHref => $"sms:?body={Uri.EscapeDataString(ShareText + " " + ShareUrl)}";
    private string FacebookHref => $"https://www.facebook.com/sharer/sharer.php?u={Uri.EscapeDataString(ShareUrl)}";
    private string TwitterHref => $"https://twitter.com/intent/tweet?text={Uri.EscapeDataString(ShareText)}&url={Uri.EscapeDataString(ShareUrl)}";
    private string LinkedInHref => $"https://www.linkedin.com/sharing/share-offsite/?url={Uri.EscapeDataString(ShareUrl)}";
    private string WhatsAppHref => $"https://wa.me/?text={Uri.EscapeDataString(ShareText + " " + ShareUrl)}";
    private string TelegramHref => $"https://t.me/share/url?url={Uri.EscapeDataString(ShareUrl)}&text={Uri.EscapeDataString(ShareText)}";

    private async Task<IJSObjectReference> ModuleAsync()
        => _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/share.js");

    private async Task OnShareClick()
    {
        var module = await ModuleAsync();
        if (await module.InvokeAsync<bool>("canShare"))
        {
            await module.InvokeVoidAsync("nativeShare", Title, ShareText, ShareUrl);
            return;
        }

        _menuOpen = !_menuOpen;
    }

    private async Task CopyLink()
    {
        var module = await ModuleAsync();
        _copied = await module.InvokeAsync<bool>("copyToClipboard", ShareUrl);
        _menuOpen = false;
        StateHasChanged();
        if (_copied)
        {
            await Task.Delay(1500);
            _copied = false;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
    }
}
