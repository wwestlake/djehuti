@namespace Djehuti.DjeLab.Components
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IAsyncDisposable

<div class="djelab-share">
    <button type="button"
            class="djelab-share-button"
            aria-haspopup="true"
            aria-expanded="@_menuOpen.ToString().ToLowerInvariant()"
            @onclick="OnShareClick">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="18" cy="5" r="3"></circle>
            <circle cx="6" cy="12" r="3"></circle>
            <circle cx="18" cy="19" r="3"></circle>
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
        </svg>
        <span>Share</span>
    </button>

    @if (_menuOpen)
    {
        <div class="djelab-share-backdrop" @onclick="CloseMenu"></div>
        <div class="djelab-share-menu">
            <button type="button" class="djelab-share-item" @onclick="CopyLink">
                @(_copied ? "Copied!" : "Copy link")
            </button>
            <a class="djelab-share-item" href="@MailtoLink">Email</a>
            <a class="djelab-share-item" href="@SmsLink">SMS</a>
            <a class="djelab-share-item" href="@FacebookLink" target="_blank" rel="noopener noreferrer">Facebook</a>
            <a class="djelab-share-item" href="@TwitterLink" target="_blank" rel="noopener noreferrer">X (Twitter)</a>
            <a class="djelab-share-item" href="@LinkedInLink" target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <a class="djelab-share-item" href="@WhatsAppLink" target="_blank" rel="noopener noreferrer">WhatsApp</a>
            <a class="djelab-share-item" href="@TelegramLink" target="_blank" rel="noopener noreferrer">Telegram</a>
        </div>
    }
</div>

@code {
    /// <summary>Page title to share. Defaults to the current document title.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Short share text. Defaults to <see cref="Title"/>.</summary>
    [Parameter] public string? Text { get; set; }

    /// <summary>URL to share. Defaults to the current page URL.</summary>
    [Parameter] public string? Url { get; set; }

    private IJSObjectReference? _module;
    private bool _menuOpen;
    private bool _copied;

    private string ShareUrl => Url ?? Nav.Uri;
    private string Encoded => Uri.EscapeDataString(ShareUrl);

    private string MailtoLink => $"mailto:?subject={Uri.EscapeDataString(Title ?? "")}&body={Uri.EscapeDataString(ShareUrl)}";
    private string SmsLink => $"sms:?body={Uri.EscapeDataString((Title ?? "") + " " + ShareUrl)}";
    private string FacebookLink => $"https://www.facebook.com/sharer/sharer.php?u={Encoded}";
    private string TwitterLink => $"https://twitter.com/intent/tweet?text={Uri.EscapeDataString(Title ?? "")}&url={Encoded}";
    private string LinkedInLink => $"https://www.linkedin.com/sharing/share-offsite/?url={Encoded}";
    private string WhatsAppLink => $"https://wa.me/?text={Uri.EscapeDataString((Title ?? "") + " " + ShareUrl)}";
    private string TelegramLink => $"https://t.me/share/url?url={Encoded}&text={Uri.EscapeDataString(Title ?? "")}";

    private async Task<IJSObjectReference> ModuleAsync()
        => _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/share.js");

    private async Task OnShareClick()
    {
        var module = await ModuleAsync();
        var canShare = await module.InvokeAsync<bool>("canShare");
        if (canShare)
        {
            var title = Title ?? await module.InvokeAsync<string>("currentTitle");
            await module.InvokeAsync<bool>("nativeShare", title, Text ?? title, ShareUrl);
            return;
        }

        _menuOpen = true;
    }

    private void CloseMenu()
    {
        _menuOpen = false;
        _copied = false;
    }

    private async Task CopyLink()
    {
        var module = await ModuleAsync();
        _copied = await module.InvokeAsync<bool>("copyToClipboard", ShareUrl);
        StateHasChanged();
        await Task.Delay(1500);
        _copied = false;
        _menuOpen = false;
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.DisposeAsync();
        }
    }
}
